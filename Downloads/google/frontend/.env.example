# Frontend environment — copy to .env.local for development.

# BFF targets — the Next.js rewrites in next.config.js use these.
FRAUD_SERVICE_URL=http://localhost:8080
RISK_SERVICE_URL=http://localhost:8081
CHAT_SERVICE_URL=http://localhost:8082

# Public env (exposed to the browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8083/ws/alerts

# Auth (when wired up)
NEXT_PUBLIC_IDP_ISSUER=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me

# GCP project (only for client-side telemetry)
NEXT_PUBLIC_GCP_PROJECT_ID=
